# MacroRAG — environment template. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored and is NEVER copied into an image (see .dockerignore).
# Every value here is a PLACEHOLDER — never commit real keys, ARNs, or account ids.
#
# Two kinds of variable live here:
#   1. DEPLOYMENT WIRING — endpoints + mode. Precedence: env > configs/rag.yaml > code defaults.
#   2. SECRETS — API keys. Any secret may instead be supplied as <NAME>_FILE pointing at a
#      mounted file (Docker/K8s/AWS Secrets Manager convention); the file wins over the plain
#      var. Resolved by utils.config.read_secret and ingest.common.config.get_secret.
#
# On AWS these are rendered to /opt/macrorag/.env at instance boot from Secrets Manager /
# SSM Parameter Store — see docs/guides/09-packaging-and-deployment.md.

# ── 1. Deploy mode & object storage ─────────────────────────────────────────
# local (default) = everything on the local filesystem.
# aws             = corpus object data (raw/processed/manifest) on S3.
MACRORAG_DEPLOY_MODE=local
# Only used when MACRORAG_DEPLOY_MODE=aws (or MACRORAG_STORAGE_BACKEND=s3).
# S3 CREDENTIALS ARE NOT SET HERE — boto3 uses the EC2 instance role / ambient AWS chain.
#MACRORAG_STORAGE_BACKEND=s3
#MACRORAG_S3_BUCKET=<corpus-bucket-name>
#MACRORAG_S3_PREFIX=corpus
#MACRORAG_S3_REGION=<aws-region>

# ── 2. External services (endpoints only — no credentials) ──────────────────
# Qdrant vector store. Server mode is required in production (on-disk deadlocks
# on bulk upsert). Local dev may omit this and use the embedded on-disk store.
#MACRORAG_QDRANT_URL=http://localhost:6333
# Optional: only if the Qdrant server enforces an API key (see configs/rag.yaml
# qdrant.api_key_env). Supports QDRANT_API_KEY_FILE.
#QDRANT_API_KEY=<qdrant-api-key>

# RagInference — the shared bge-m3 embedder + bge-reranker service. REQUIRED for
# retrieval; the serving image ships no torch. Empty value forces in-process models.
RAGINFER_URL=http://localhost:8799
#RAGINFER_FALLBACK_LOCAL=true      # load models in-process if the service is down
#RAGINFER_TIMEOUT_S=300            # CPU rerank is slow; default 300s
#RAGINFER_EMBED_MODEL=<model-id>
#RAGINFER_RERANK_MODEL=<model-id>

# Redis — backs the optional shared cache / rate-limit / job-lock backends.
#MACRORAG_REDIS_URL=redis://localhost:6379/0

# OpenTelemetry collector (traces). Setting the endpoint implies otel_enabled.
#MACRORAG_OTEL_ENDPOINT=http://localhost:4317
#MACRORAG_OTEL_ENABLED=true

# ── 3. LLM provider secrets (at least one required for generation) ──────────
# The active provider comes from configs/rag.yaml (llm.provider); its key env var
# is derived from the provider. Both support the <NAME>_FILE variant.
OPENAI_API_KEY=<openai-api-key>
#ANTHROPIC_API_KEY=<anthropic-api-key>
#OPENAI_API_KEY_FILE=/run/secrets/openai_api_key

# ── 4. Data-source API keys (only for the tiers you actually ingest) ────────
# Ingestion is on-demand; a missing key only disables that source's endpoints.
# See configs/ingest/tier*.yaml for which endpoints need which key.
#FRED_API_KEY=<fred-api-key>          # tier1 — Federal Reserve economic data
#BEA_API_KEY=<bea-api-key>            # tier3 — Bureau of Economic Analysis
#BLS_API_KEY=<bls-api-key>            # tier3 — Bureau of Labor Statistics
#CENSUS_API_KEY=<census-api-key>      # tier6c — Census BTOS
#EIA_API_KEY=<eia-api-key>            # tier6a — Energy Information Administration
#PJM_API_KEY=<pjm-api-key>            # tier6a — PJM grid data
#FINRA_CLIENT_ID=<finra-client-id>    # tier2 — FINRA
#FINRA_CLIENT_SECRET=<finra-client-secret>
#IEA_API_KEY=<iea-api-key>            # tier4 — International Energy Agency
#USITC_API_KEY=<usitc-api-key>        # tier6b — US International Trade Commission

# Contact address sent in the ingest User-Agent (configs/ingest/common.yaml). Agencies
# rate-limit or block anonymous crawlers, so set it before ingesting.
#MACRORAG_CONTACT_EMAIL=you@example.com

# ── 5. Models / misc ────────────────────────────────────────────────────────
# HuggingFace cache — only matters on a host that loads models in-process
# (local dev, or the RagInference host). The serving image never loads models.
#HF_HOME=<path-to-hf-cache>
#HUGGINGFACEHUB_API_TOKEN=<hf-token>

#LOG_LEVEL=INFO
#MACRORAG_LOG_JSON=true               # structured JSON logs (recommended in prod)
