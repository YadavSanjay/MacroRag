# Keep the build context small and free of host/build artifacts and secrets.
# Applies to both the API (infra/docker/Dockerfile) and UI (ui/Dockerfile) builds,
# which use the repo root as their build context.

# UI build artifacts (the image builds these itself via npm ci + vite build).
ui/node_modules
ui/dist

# Python build/venv/cache artifacts.
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info

# Runtime data, models, traces — never belong in an image.
data/

# Secrets — must never enter a build context/layer.
.env
.env.*
*.env

# VCS / editor / OS noise.
.git
.gitignore
.vscode
.idea
.DS_Store

# Docs/tests aren't needed to build either image.
docs/
test/
