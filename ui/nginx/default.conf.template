# MacroRAG UI nginx config (templated). ${API_UPSTREAM} is substituted at
# container start by nginx's 20-envsubst-on-templates.sh entrypoint. Only env
# vars that are DEFINED get substituted, so nginx runtime vars ($uri, $host,
# $scheme, …) are left intact — do not export those as env vars.

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Hashed build assets: safe to cache forever (Vite fingerprints filenames).
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # API reverse proxy. The trailing slash on proxy_pass strips the /api/ prefix
    # (nginx replaces the matched location prefix with "/"), reproducing the dev
    # Vite proxy's rewrite so the bundle's relative /api base reaches root-level
    # backend routes (/healthz, /query, /admin/…).
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE / streaming endpoints (POST /api/query/stream, GET
        # /api/admin/jobs/{id}/stream): disable buffering and use long read
        # timeouts, or frames arrive in one lump at stream end.
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Connection "";
    }

    # SPA fallback: client-side routing (react-router) — unknown paths serve the
    # app shell so deep links / hard refreshes work. Security headers live here
    # (on the HTML document) so the CSP governs the whole page. Note the nginx
    # add_header inheritance rule: a location with its own add_header (e.g.
    # /assets/) does NOT inherit these — that's fine, only the document needs them.
    location / {
        try_files $uri $uri/ /index.html;

        # script-src 'self': the only scripts are same-origin (/theme-init.js +
        # the hashed module bundle) — no inline script, no hash needed.
        # style-src allows 'unsafe-inline' because the React app uses inline
        # style={{…}} attributes throughout. connect-src 'self' covers the
        # same-origin /api fetch + SSE.
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'self'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    }
}
